{
  "pages": [
    {
      "name": "part9_supporting_documents",
      "title": "Part 9 – Supporting documents",
      "description": "Please provide links to the latest versions of the following documents (website, SharePoint, OneDrive, Google Drive, etc.). If a document is not available online, please email it to smit1@un.org",
      "elements": [
      {
      "type": "panelDynamic",
      "name": "law_documents",
      "title": "Relevant laws and other legal documents, apart from the Statistical Services Act 1980 (e.g., on data protection, access to information, confidentiality, etc.)",
      "templateTitle": "Document {panelIndex}",
      "panelAddText": "Add another document",
      "panelRemoveText": "Remove",
      "minPanelCount": 1,
      "templateElements": [
        {
          "type": "text",
          "name": "description",
          "title": "Description of the document",
          "isRequired": false
        },
        {
          "type": "text",
          "name": "link",
          "title": "Link to document",
          "inputType": "url",
          "placeholder": "https://..."
        }
      ]
      }, 
       {
          "type": "panel",
          "name": "org_chart",
          "title": "Organization chart for the national statistical office",
          "elements": [
            {
              "type": "text",
              "name": "org_chart_link",
              "title": "Link to document",
              "inputType": "url"
            }          ]
        },
        {
          "type": "panel",
          "name": "annual_work_programme",
          "title": "Annual work programme",
          "elements": [
            {
              "type": "text",
              "name": "work_programme_link",
              "title": "Link to document",
              "inputType": "url"
            }
          ]
        },
        {
          "type": "panel",
          "name": "staff_overview",
          "title": "Staff overview (number of staff, by category)",
          "elements": [
            {
              "type": "text",
              "name": "staff_overview_link",
              "title": "Link to document",
              "inputType": "url"
            }
          ]
        },
        {
          "type": "panel",
          "name": "budget_overview",
          "title": "Budget overview (total budget, by source of funding, by category of expenditure, etc.)",
          "elements": [
            {
              "type": "text",
              "name": "budget_overview_link",
              "title": "Link to document",
              "inputType": "url"
            }
          ]
        },
        {
          "type": "panel",
          "name": "release_calendar",
          "title": "Statistical release calendar",
          "elements": [
            {
              "type": "text",
              "name": "release_calendar_link",
              "title": "Link to document",
              "inputType": "url"
            }
          ]
        },
      {
      "type": "panelDynamic",
      "name": "policy_documents",
      "title": "Policy documents (e.g., on quality, confidentiality, data protection, dissemination, revisions, etc.)",
      "templateTitle": "Document {panelIndex}",
      "panelAddText": "Add another document",
      "panelRemoveText": "Remove",
      "minPanelCount": 1,
      "templateElements": [
        {
          "type": "text",
          "name": "description",
          "title": "Description of the document",
          "isRequired": false
        },
        {
          "type": "text",
          "name": "link",
          "title": "Link to document",
          "inputType": "url",
          "placeholder": "https://..."
        }
      ]
      },
      {
      "type": "panelDynamic",
      "name": "methodology_documents",
      "title": "Methodology documents (e.g., on data collection instruments such as censuses and sample surveys; compilation of statistical outputs, etc.)",
      "templateTitle": "Document {panelIndex}",
      "panelAddText": "Add another document",
      "panelRemoveText": "Remove",
      "minPanelCount": 1,
      "templateElements": [
        {
          "type": "text",
          "name": "description",
          "title": "Description of the document",
          "isRequired": false
        },
        {
          "type": "text",
          "name": "link",
          "title": "Link to document",
          "inputType": "url",
          "placeholder": "https://..."
        }
      ]
      }
    ]
    }
  ]
}
