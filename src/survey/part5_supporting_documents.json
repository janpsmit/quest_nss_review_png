          "panelAddText": "Add another document",
          "panelRemoveText": "Remove",
          "minPanelCount": 1,
          "templateElements": [
            {
              "type": "text",
              "name": "description",
              "title": "Description of the document"
            },
            {
              "type": "text",
              "name": "link",
